# Example production Caddyfile with automatic HTTPS

your.domain.com {
    # 1. Path to your files
    root * /data/file-server

    # 2. Serve MeowIndex WhiteSur MIME icons
    handle /mime/* {
        root * /etc/caddy/MeowIndex/public
        file_server
    }

    # 3. Serve directory browsing with MeowIndex template
    handle {
        file_server {
            browse /etc/caddy/MeowIndex/docs/meowindex.html
        }
    }

    # Optional compression
    encode zstd gzip

    # Optional security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}
