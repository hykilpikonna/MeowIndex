# MeowIndex Caddy Configuration
#
# Put this in your Caddyfile:
:80 {
    # 1. Path to your static files
    root * /data/file-server

    # 2. Serve WhiteSur MIME icons from MeowIndex
    handle /mime/* {
        root * /etc/caddy/MeowIndex/public
        file_server
    }

    # 3. Serve directory listing using MeowIndex template
    handle {
        file_server {
            browse /etc/caddy/MeowIndex/docs/meowindex.html
        }
    }
}
